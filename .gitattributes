# Normalize repository text files to LF.
* text=auto eol=lf

# Windows-native scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.onnx binary
*.pt binary
*.pth binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary